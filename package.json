{
  "name": "spiritbound",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A Godot possession puzzle in a reclaimed woodland.",
  "scripts": {
    "start": "powershell -NoProfile -File tools/godot.ps1 -Action play",
    "test": "powershell -NoProfile -File tools/godot.ps1 -Action test",
    "check": "powershell -NoProfile -File tools/godot.ps1 -Action check",
    "export:web": "powershell -NoProfile -File tools/godot.ps1 -Action web",
    "export:windows": "powershell -NoProfile -File tools/godot.ps1 -Action windows",
    "serve": "node server.js"
  }
}
