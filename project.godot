; Spiritbound: one room, one possession loop.
config_version=5

[application]
config/name="Spiritbound"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A spirit moves through ordinary animals in a reclaimed woodland."

[display]
window/size/viewport_width=1100
window/size/viewport_height=760
window/size/window_width_override=1100
window/size/window_height_override=760
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]
common/physics_jitter_fix=0.0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.058, 0.06, 1)
textures/default_filters/use_nearest_mipmap_filter=false
